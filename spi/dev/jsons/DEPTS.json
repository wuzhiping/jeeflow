{
  "version": "1.1.0",
  "description": "FlowMatrix 研发组织架构 · 5 部门 tree 结构 (重构 v9 · 替换 v8 LEV) · 13 人员分布 · 角色组合",
  "encoding": {
    "structure": "tree (扁平存储 + parent_id + 派生嵌套)",
    "relationship": "父部门 = parent_id (顶层部门 parent_id = null)",
    "example": {
      "D99": {
        "name": "总经办",
        "parent_id": null
      },
      "D01": {
        "name": "研发部",
        "parent_id": "D99"
      },
      "D02": {
        "name": "前端组",
        "parent_id": "D01"
      }
    },
    "tree_query": "SPI_DEPTS_TREE (data.py 派生) → {dept_id: {name, leader, children: {...递归嵌套...}}}"
  },
