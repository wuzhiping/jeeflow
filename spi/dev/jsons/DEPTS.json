{
  "version": "1.3.0",
  "description": "FlowMatrix 研发组织架构 · 6 部门 tree 结构（顶层 2 根：D99 总经办 + DFDEP FDEP协作组） · 14 人员分布（含 1 FDEP 占位） · 角色组合",
  "encoding": {
    "structure": "tree with parallel roots (扁平存储 + parent_id + 派生嵌套；顶层部门 = parent_id = null，可多个)",
    "relationship": "父部门 = parent_id (顶层部门 parent_id = null，含 D99 与 DFDEP 两个并行根)",
    "example": {
      "D99": {
        "name": "总经办",
        "parent_id": null
      },
      "DFDEP": {
        "name": "FDEP协作组",
        "parent_id": null
      },
      "D01": {
        "name": "研发部",
        "parent_id": "D99"
      },
      "D02": {
        "name": "前端组",
        "parent_id": "D01"
      }
    },
    "tree_query": "SPI_DEPTS_TREE (data.py 派生) → {dept_id: {name, leader, children: {...递归嵌套...}}}"
  },
  "departments": {
