  "edges": [
    {"id": "e0", "sourceNodeId": "start", "targetNodeId": "apply", "properties": {}},
    {"id": "e1", "sourceNodeId": "apply", "targetNodeId": "decision_cat", "properties": {}},
    {"id": "e_travel", "sourceNodeId": "decision_cat", "targetNodeId": "leader_review", "properties": {"expr": "f_category==1"}, "text": {"value": "1差旅"}},
    {"id": "e_office", "sourceNodeId": "decision_cat", "targetNodeId": "manager_review", "properties": {"expr": "f_category==2"}, "text": {"value": "2办公"}},
    {"id": "e_other", "sourceNodeId": "decision_cat", "targetNodeId": "finance", "properties": {"expr": "f_category==3"}, "text": {"value": "3其他"}},
    {"id": "e_leader_end", "sourceNodeId": "leader_review", "targetNodeId": "end", "properties": {}},
    {"id": "e_mgr_end", "sourceNodeId": "manager_review", "targetNodeId": "end", "properties": {}},
    {"id": "e_fin_end", "sourceNodeId": "finance", "targetNodeId": "end", "properties": {}}
