        "width": 100, "height": 50,
        "form": "expense-form",
        "assignee": "user1",
        "taskType": 0, "performType": 0,
        "field": {
          "PERMISSION_f_category": 1,
          "PERMISSION_f_amount": 1,
          "PERMISSION_f_reason": 1,
          "f_applyUser": "user1"
        }
      },
      "text": {"value": "填写报销单"}
    },
    {
      "id": "decision_cat",
      "type": "snaker:decision",
