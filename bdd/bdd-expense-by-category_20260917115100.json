      "properties": {"width": 100, "height": 50, "expr": "f_category==1", "handleClass": ""},
      "text": {"value": "类别?(1差旅/2办公/3其他)"}
    },
    {
      "id": "leader_review",
      "type": "snaker:task",
      "x": 550, "y": 50,
      "properties": {
        "width": 100, "height": 50,
        "form": "expense-form",
        "assignee": "leader",
        "taskType": 0, "performType": 0,
        "field": {"PERMISSION_f_amount": 1, "PERMISSION_f_reason": 1}
      },
      "text": {"value": "组长初审(差旅)"}
    },
    {
      "id": "manager_review",
      "type": "snaker:task",
      "x": 550, "y": 200,
      "properties": {
        "width": 100, "height": 50,
        "form": "expense-form",
        "assignee": "manager",
        "taskType": 0, "performType": 0,
        "field": {"PERMISSION_f_amount": 1, "PERMISSION_f_reason": 1}
      },
      "text": {"value": "经理审批(办公)"}
    },
    {
      "id": "finance",
      "type": "snaker:task",
      "x": 550, "y": 350,
      "properties": {
        "width": 100, "height": 50,
        "form": "expense-form",
        "assignmentHandler": "com.mldong.jeeflow.interceptor.impl.OrgUserAssignmentHandlers$TaskRoleAssigneeHandler",
        "taskType": 0, "performType": 0,
        "field": {"PERMISSION_f_amount": 1, "PERMISSION_f_reason": 1}
      },
      "text": {"value": "财务复核(其他)"}
